# Browser (bundled into the site): https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=

# Server only (/api functions). Never prefix these with VITE_.
# Gemini: https://aistudio.google.com/apikey  (optional: AI picks)
GEMINI_API_KEY=
# Reddit app (reddit.com/prefs/apps, type "script"). Use "none" to skip.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
